<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      miuix-blur declares Android minSdk 33 (its shader path needs API 33).
      The app keeps minSdk 30 on purpose: the blur artifacts are only ever
      *initialized* behind isRuntimeShaderSupported(), so on API 30-32 they are
      never loaded. tools:overrideLibrary records that deliberate choice; the
      runtime capability branch in AboutPage is what keeps this safe.
    -->
    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Retain Lite's launcher/task-metadata visibility contract; this is not a Play Store release. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="ExtBridge Lite"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.extbridge.helper.tablet"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TouchpadActivity"
            android:exported="true"
            android:label="大触摸板"
            android:launchMode="singleTask"
            android:taskAffinity="com.extbridge.helper.tablet"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode" />

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="扩展桌面"
            android:launchMode="singleTask"
            android:taskAffinity="com.extbridge.helper.extdesktop"
            android:resizeableActivity="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density" />

        <service
            android:name=".BridgeService"
            android:exported="true"
            android:permission="android.permission.INJECT_EVENTS"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="External display overlay controller and cursor presenter" />
        </service>

        <service
            android:name=".NavAssistService"
            android:exported="true"
            android:label="ExtBridge 平板辅助手势"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/nav_assist_config" />
        </service>

        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="android.permission.INJECT_EVENTS">
            <intent-filter>
                <action android:name="com.extbridge.helper.BINDER_PUSH" />
                <action android:name="com.extbridge.helper.TOGGLE_INPUT" />
                <action android:name="com.extbridge.helper.STATE_SYNC" />
                <action android:name="com.extbridge.helper.REBUILD" />
                <action android:name="com.extbridge.helper.LAUNCH_EXT_HOME" />
                <action android:name="com.extbridge.helper.TOGGLE_MIRROR" />
                <action android:name="com.extbridge.helper.SPLIT_ACTION" />
                <action android:name="com.extbridge.helper.SET_ROTATION" />
                <action android:name="com.extbridge.helper.SET_DOCK_AUTO_HIDE" />
                <action android:name="com.extbridge.helper.EXIT_ALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ControlReceiver$Internal"
            android:exported="false" />

        <receiver
            android:name=".AdbPairingReceiver"
            android:exported="false" />

        <provider
            android:name=".BridgeProvider"
            android:authorities="com.extbridge.helper.provider"
            android:exported="true" />
    </application>
</manifest>
